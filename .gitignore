# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# private admin credentials (never commit)
ADMIN-CREDENTIALS.local.json
ADMIN-CREDENTIALS.local.md
ADMIN-CREDENTIALS.local.*
!ADMIN-CREDENTIALS.example.json
backend-dev/TEST-FULL-WALKTHROUGH-FA.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prototype / design reference (not part of Next.js app)
/pastour
/samtrackstatic
