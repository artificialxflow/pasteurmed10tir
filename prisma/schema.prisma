generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  pending
  approved
  rejected
}

model User {
  id                 String              @id @default(cuid())
  phone              String              @unique
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            PatientProfile?
  bookings           Booking[]
  consultations      Consultation[]
  insuranceInquiries InsuranceInquiry[]
  reminders          Reminder[]
  doctorReviews      DoctorReview[]
  complaints         Complaint[]
}

model PatientProfile {
  id                       String        @id @default(cuid())
  userId                   String        @unique
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalId               String?
  baseInsuranceId          String?
  complementaryInsuranceId String?
  franchisePercent         Int           @default(30)
  status                   PatientStatus @default(pending)
  reviewedAt               DateTime?
  reviewNote               String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
}

model AdminRole {
  id          String      @id
  name        String
  description String?
  permissions String[]
  users       AdminUser[]
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  roleId       String
  role         AdminRole @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Service {
  id          String  @id
  title       String
  emoji       String  @default("🧩")
  description String  @default("")
  href        String
  image       String
  color       String  @default("teal")
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model LaserService {
  id          String  @id
  title       String
  emoji       String  @default("✨")
  price       String
  priceNum    Int?
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model NursingService {
  id          String        @id
  title       String
  emoji       String
  price       String
  description String        @default("")
  image       String?
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  items       NursingItem[]
}

model NursingItem {
  id        String         @id
  serviceId String
  service   NursingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title     String
  priceNum  Int
  price     String?
  unit      String?
  active    Boolean        @default(true)
  sortOrder Int            @default(0)

  @@index([serviceId])
}

model Physician {
  id          Int      @id
  name        String
  specialty   String
  specialtyId String?
  image       String
  days        String[]
  status      String   @default("available")
}

model GalleryItem {
  id       Int    @id
  category String
  title    String
  before   String
  after    String
}

model Product {
  id       Int    @id
  name     String
  category String
  price    String
  priceNum Int
  stock    Int    @default(0)
  image    String
}

model BaseInsurance {
  id     String  @id
  name   String
  active Boolean @default(true)
}

model ComplementaryInsurance {
  id     String  @id
  name   String
  active Boolean @default(true)
}

model ConsultationType {
  id       String @id
  label    String
  emoji    String
  desc     String
  priceNum Int?
  price    String?
}

model SiteSettings {
  id                     String @id @default("default")
  dentalReservationFee   Int    @default(200000)
  walletRegularCap       Int    @default(15000000)
  walletMembershipVipCap Int    @default(30000000)
  walletShopVipCap       Int    @default(20000000)
  walletGraceMonths      Int    @default(1)
  walletInstallmentMin   Int    @default(4)
  walletInstallmentMax   Int    @default(6)
}

model SpecialtyTariff {
  id      String @id @default("default")
  tariffs Json
}

model MediaAsset {
  id        String   @id @default(cuid())
  path      String
  mime      String
  filename  String
  sourceUrl String?
  createdAt DateTime @default(now())
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

enum ConsultationStatus {
  pending
  answered
}

enum InsuranceInquiryStatus {
  pending
  approved
  rejected
}

enum ReviewStatus {
  pending
  approved
  hidden
}

enum ComplaintStatus {
  new
  reviewing
  closed
}

enum PartnerRequestStatus {
  new
  reviewing
  approved
  rejected
}

enum ReminderStatus {
  active
  cancelled
  sent
}

model Booking {
  id                   String        @id
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone         String
  patientName          String?
  doctorId             String?
  doctorName           String?
  specialty            String?
  type                 String?
  typeLabel            String?
  day                  String?
  timeValue            String?
  timeLabel            String?
  amount               Int           @default(0)
  isDeposit            Boolean       @default(true)
  depositNonRefundable Boolean       @default(true)
  status               BookingStatus @default(confirmed)
  dateLabel            String?
  referralCode         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  reminders            Reminder[]

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
  @@index([doctorId, day, type])
}

model Consultation {
  id                     String             @id
  userId                 String?
  user                   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone           String
  patientName            String?
  type                   String?
  typeLabel              String?
  category               String?
  categoryLabel          String?
  specialty              String?
  specialtyLabel         String?
  doctorId               String?
  doctorName             String?
  description            String?
  estimate               String?
  amount                 Int                @default(0)
  priceSource            String?
  hasImage               Boolean            @default(false)
  onlineInsuranceCovered Boolean            @default(false)
  status                 ConsultationStatus @default(pending)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
}

model InsuranceInquiry {
  id                       String                 @id
  userId                   String?
  user                     User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone             String
  patientName              String?
  mode                     String
  baseInsuranceId          String?
  complementaryInsuranceId String?
  franchisePercent         Int                    @default(30)
  visitFee                 Int                    @default(0)
  depositAmount            Int                    @default(0)
  status                   InsuranceInquiryStatus @default(pending)
  createdAt                DateTime               @default(now())
  resolvedAt               DateTime?

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
}

model Reminder {
  id           String         @id
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  patientPhone String
  patientName  String?
  doctorName   String?
  day          String?
  timeLabel    String?
  typeLabel    String?
  optionId     String?
  optionLabel  String?
  status       ReminderStatus @default(active)
  notified     Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([userId])
  @@index([bookingId])
}

model DoctorReview {
  id           String       @id
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone String
  doctorId     String
  doctorName   String
  doctorKind   String
  rating       Int
  comment      String
  status       ReviewStatus @default(pending)
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([status])
}

model Complaint {
  id           String          @id
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone String
  patientName  String
  subject      String
  message      String
  status       ComplaintStatus @default(new)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model PartnerRequest {
  id           String               @id
  type         String
  typeLabel    String?
  patientName  String
  patientPhone String
  specialty    String?
  city         String?
  description  String?
  notes        String?
  status       PartnerRequestStatus @default(new)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
}
