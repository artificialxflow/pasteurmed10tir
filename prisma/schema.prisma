generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  pending
  approved
  rejected
}

model User {
  id        String          @id @default(cuid())
  phone     String          @unique
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  profile   PatientProfile?
}

model PatientProfile {
  id                       String        @id @default(cuid())
  userId                   String        @unique
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalId               String?
  baseInsuranceId          String?
  complementaryInsuranceId String?
  franchisePercent         Int           @default(30)
  status                   PatientStatus @default(pending)
  reviewedAt               DateTime?
  reviewNote               String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
}

model AdminRole {
  id          String      @id
  name        String
  description String?
  permissions String[]
  users       AdminUser[]
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  roleId       String
  role         AdminRole @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Service {
  id          String  @id
  title       String
  emoji       String  @default("🧩")
  description String  @default("")
  href        String
  image       String
  color       String  @default("teal")
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model LaserService {
  id          String  @id
  title       String
  emoji       String  @default("✨")
  price       String
  priceNum    Int?
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model NursingService {
  id          String        @id
  title       String
  emoji       String
  price       String
  description String        @default("")
  image       String?
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  items       NursingItem[]
}

model NursingItem {
  id        String         @id
  serviceId String
  service   NursingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title     String
  priceNum  Int
  price     String?
  unit      String?
  active    Boolean        @default(true)
  sortOrder Int            @default(0)

  @@index([serviceId])
}

model Physician {
  id          Int      @id
  name        String
  specialty   String
  specialtyId String?
  image       String
  days        String[]
  status      String   @default("available")
}

model GalleryItem {
  id       Int    @id
  category String
  title    String
  before   String
  after    String
}

model Product {
  id       Int    @id
  name     String
  category String
  price    String
  priceNum Int
  stock    Int    @default(0)
  image    String
}

model BaseInsurance {
  id     String  @id
  name   String
  active Boolean @default(true)
}

model ComplementaryInsurance {
  id     String  @id
  name   String
  active Boolean @default(true)
}

model ConsultationType {
  id       String @id
  label    String
  emoji    String
  desc     String
  priceNum Int?
  price    String?
}

model SiteSettings {
  id                     String @id @default("default")
  dentalReservationFee   Int    @default(200000)
  walletRegularCap       Int    @default(15000000)
  walletMembershipVipCap Int    @default(30000000)
  walletShopVipCap       Int    @default(20000000)
  walletGraceMonths      Int    @default(1)
  walletInstallmentMin   Int    @default(4)
  walletInstallmentMax   Int    @default(6)
}

model SpecialtyTariff {
  id      String @id @default("default")
  tariffs Json
}

model MediaAsset {
  id        String   @id @default(cuid())
  path      String
  mime      String
  filename  String
  sourceUrl String?
  createdAt DateTime @default(now())
}
