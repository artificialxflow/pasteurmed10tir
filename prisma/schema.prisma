generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  pending
  approved
  rejected
}

model User {
  id                 String              @id @default(cuid())
  phone              String              @unique
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            PatientProfile?
  bookings           Booking[]
  consultations      Consultation[]
  insuranceInquiries InsuranceInquiry[]
  reminders          Reminder[]
  doctorReviews      DoctorReview[]
  complaints         Complaint[]
  supportTickets     SupportTicket[]
  members            Member[]
  wallets            Wallet[]
  shopOrders         ShopOrder[]
  clubProfile        ClubProfile?
}

model PatientProfile {
  id                       String        @id @default(cuid())
  userId                   String        @unique
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalId               String?
  baseInsuranceId          String?
  complementaryInsuranceId String?
  franchisePercent         Int           @default(30)
  status                   PatientStatus @default(pending)
  reviewedAt               DateTime?
  reviewNote               String?
  zohalStatus              String?
  zohalPayload             Json?
  shahkarMatched           Boolean?
  zohalCheckedAt           DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model AdminRole {
  id          String      @id
  name        String
  description String?
  permissions String[]
  users       AdminUser[]
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  roleId       String
  role         AdminRole @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Service {
  id          String  @id
  title       String
  emoji       String  @default("🧩")
  description String  @default("")
  href        String
  image       String
  color       String  @default("teal")
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model LaserService {
  id          String  @id
  title       String
  emoji       String  @default("✨")
  price       String
  priceNum    Int?
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model NursingService {
  id          String        @id
  title       String
  emoji       String
  price       String
  description String        @default("")
  image       String?
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  items       NursingItem[]
}

model NursingItem {
  id        String         @id
  serviceId String
  service   NursingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title     String
  priceNum  Int
  price     String?
  unit      String?
  active    Boolean        @default(true)
  sortOrder Int            @default(0)

  @@index([serviceId])
}

model Physician {
  id          Int      @id
  name        String
  specialty   String
  specialtyId String?
  image       String
  days        String[]
  status      String   @default("available")
  sortOrder   Int      @default(0)
}

model Dentist {
  id          Int      @id
  name        String
  specialty   String
  specialtyId String?
  image       String
  days        String[]
  hours       String   @default("")
  status      String   @default("available")
  schedule    Json     @default("{}")
  sortOrder   Int      @default(0)
}

model GalleryItem {
  id       Int    @id
  category String
  title    String
  before   String
  after    String
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
}

model Product {
  id          Int              @id
  name        String
  slug        String           @unique
  description String           @default("")
  category    String
  categoryId  Int?
  categoryRel ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price       String
  priceNum    Int
  stock       Int              @default(0)
  image       String
  images      String[]         @default([])
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
}

model BaseInsurance {
  id     String  @id
  name   String
  active Boolean @default(true)
}

model ComplementaryInsurance {
  id     String  @id
  name   String
  active Boolean @default(true)
}

model ConsultationType {
  id       String @id
  label    String
  emoji    String
  desc     String
  priceNum Int?
  price    String?
}

model SiteSettings {
  id                     String @id @default("default")
  dentalReservationFee   Int    @default(200000)
  walletRegularCap       Int    @default(15000000)
  walletMembershipVipCap Int    @default(30000000)
  walletShopVipCap       Int    @default(20000000)
  walletGraceMonths      Int    @default(1)
  walletInstallmentMin   Int    @default(4)
  walletInstallmentMax   Int    @default(6)
}

model SpecialtyTariff {
  id      String @id @default("default")
  tariffs Json
}

model MediaAsset {
  id        String   @id @default(cuid())
  path      String
  mime      String
  filename  String
  sourceUrl String?
  createdAt DateTime @default(now())
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

enum ConsultationStatus {
  pending
  answered
}

enum InsuranceInquiryStatus {
  pending
  approved
  rejected
}

enum ReviewStatus {
  pending
  approved
  hidden
}

enum ComplaintStatus {
  new
  reviewing
  closed
}

enum SupportTicketStatus {
  open
  reviewing
  closed
}

enum SupportMessageSender {
  patient
  admin
}

enum PartnerRequestStatus {
  new
  reviewing
  approved
  rejected
}

enum ReminderStatus {
  active
  cancelled
  sent
}

model Booking {
  id                   String        @id
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone         String
  patientName          String?
  doctorId             String?
  doctorName           String?
  specialty            String?
  type                 String?
  typeLabel            String?
  day                  String?
  timeValue            String?
  timeLabel            String?
  amount               Int           @default(0)
  isDeposit            Boolean       @default(true)
  depositNonRefundable Boolean       @default(true)
  status               BookingStatus @default(confirmed)
  dateLabel            String?
  referralCode         String?
  appointmentAt        DateTime?
  reminder24Sent       Boolean       @default(false)
  reminder2Sent        Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  reminders            Reminder[]

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
  @@index([doctorId, day, type])
  @@index([appointmentAt])
}

model Consultation {
  id                     String             @id
  userId                 String?
  user                   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone           String
  patientName            String?
  type                   String?
  typeLabel              String?
  category               String?
  categoryLabel          String?
  specialty              String?
  specialtyLabel         String?
  doctorId               String?
  doctorName             String?
  description            String?
  estimate               String?
  amount                 Int                @default(0)
  priceSource            String?
  hasImage               Boolean            @default(false)
  onlineInsuranceCovered Boolean            @default(false)
  status                 ConsultationStatus @default(pending)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
}

model InsuranceInquiry {
  id                       String                 @id
  userId                   String?
  user                     User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone             String
  patientName              String?
  mode                     String
  baseInsuranceId          String?
  complementaryInsuranceId String?
  franchisePercent         Int                    @default(30)
  visitFee                 Int                    @default(0)
  depositAmount            Int                    @default(0)
  status                   InsuranceInquiryStatus @default(pending)
  createdAt                DateTime               @default(now())
  resolvedAt               DateTime?

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
}

model Reminder {
  id           String         @id
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  patientPhone String
  patientName  String?
  doctorName   String?
  day          String?
  timeLabel    String?
  typeLabel    String?
  optionId     String?
  optionLabel  String?
  status       ReminderStatus @default(active)
  notified     Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([userId])
  @@index([bookingId])
}

model DoctorReview {
  id           String       @id
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone String
  doctorId     String
  doctorName   String
  doctorKind   String
  rating       Int
  comment      String
  status       ReviewStatus @default(pending)
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([status])
}

model Complaint {
  id           String          @id
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone String
  patientName  String
  subject      String
  message      String
  status       ComplaintStatus @default(new)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model SupportTicket {
  id           String              @id
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientPhone String
  patientName  String
  subject      String
  status       SupportTicketStatus @default(open)
  priority     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  closedAt     DateTime?
  messages     SupportMessage[]

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
}

model SupportMessage {
  id        String               @id
  ticketId  String
  ticket    SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    SupportMessageSender
  body      String
  createdAt DateTime             @default(now())

  @@index([ticketId])
}

model PartnerRequest {
  id           String               @id
  type         String
  typeLabel    String?
  patientName  String
  patientPhone String
  specialty    String?
  city         String?
  description  String?
  notes        String?
  status       PartnerRequestStatus @default(new)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
}

// —— Phase 4: Commerce & finance ——

enum VisitorStatus {
  active
  inactive
}

enum CommissionStatus {
  pending
  paid
}

enum FacilityRequestStatus {
  pending
  approved
  rejected
}

enum InstallmentSource {
  credit
  facility
  membership
  wallet
  loan
}

enum InstallmentPlanStatus {
  active
  completed
  overdue
  hidden
}

enum WalletStatus {
  active
  suspended
  closed
}

enum WalletTransactionType {
  credit
  debit
  upgrade
  adjustment
}

enum WalletTransactionStatus {
  pending
  completed
  cancelled
}

enum ShopOrderStatus {
  pending
  confirmed
  shipped
  cancelled
}

model MembershipPlan {
  id                  String   @id
  name                String
  price               String
  priceNum            Int
  loanTermLabel       String
  loanLimit           Int
  downPaymentPercent  Int      @default(30)
  features            String[]
  terms               String   @default("")
  highlighted         Boolean  @default(false)
  sortOrder           Int      @default(0)
}

model Member {
  id                       String   @id
  userId                   String?
  user                     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  planId                   String?
  planName                 String?
  patientName              String?
  patientPhone             String
  amount                   Int      @default(0)
  status                   String   @default("paid")
  validityLabel            String?
  membershipDurationLabel  String?
  discountPercent          Int?
  createdAt                DateTime @default(now())

  @@index([userId])
  @@index([patientPhone])
  @@index([status])
}

model MembershipApplication {
  id                       String   @id
  patientName              String?
  phone                    String?
  nationalId               String?
  age                      String?
  job                      String?
  postalCode               String?
  homeAddress              String?
  workAddress              String?
  medicalHistory           String?
  dependents               String?
  planId                   String?
  planTitle                String?
  tier                     String?
  tierLabel                String?
  validityLabel            String?
  membershipDurationLabel  String?
  discountPercent          Int?
  memberCount              Int?
  unitPriceToman           Int?
  amountRial               Int?
  amountToman              Int?
  loanAmount               Int?
  referralCode             String?
  visitorName              String?
  status                   String   @default("pending")
  zohalStatus              String?
  zohalPayload             Json?
  shahkarMatched           Boolean?
  zohalCheckedAt           DateTime?
  reviewedAt               DateTime?
  reviewNote               String?
  source                   String?
  date                     String?
  extra                    Json?
  createdAt                DateTime @default(now())

  @@index([phone])
  @@index([status])
}

model Wallet {
  phone        String               @id
  userId       String?
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  balance      Int                  @default(0)
  ceiling      Int                  @default(15000000)
  activeKinds  String[]             @default(["regular"])
  status       WalletStatus         @default(active)
  shopVip      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions WalletTransaction[]

  @@index([userId])
  @@index([status])
}

model WalletTransaction {
  id           String                   @id
  walletPhone  String
  wallet       Wallet                   @relation(fields: [walletPhone], references: [phone], onDelete: Cascade)
  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  description  String
  status       WalletTransactionStatus  @default(completed)
  createdAt    DateTime                 @default(now())

  @@index([walletPhone])
}

model ShopOrder {
  id                 String          @id
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerType       String?
  customerTypeLabel  String?
  customerName       String?
  customerPhone      String
  address            String?
  items              Json
  subtotal           Int             @default(0)
  discount           Int             @default(0)
  total              Int             @default(0)
  status             ShopOrderStatus @default(pending)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
  @@index([customerPhone])
  @@index([status])
}

model Visitor {
  id                     Int            @id
  name                   String
  code                   String         @unique
  commissionRate         Int
  commissionRateClinical Int?
  commissionRateShop     Int?
  phone                  String
  status                 VisitorStatus  @default(active)
  commissions            Commission[]
}

model Commission {
  id               String           @id
  visitorId        Int
  visitor          Visitor          @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorName      String
  referralCode     String
  commissionRate   Int
  commissionAmount Int
  sourceType       String?
  sourceLabel      String?
  customerName     String?
  customerPhone    String?
  amount           Int              @default(0)
  status           CommissionStatus @default(pending)
  createdAt        DateTime         @default(now())

  @@index([visitorId])
  @@index([referralCode])
  @@index([status])
}

model FacilityRequest {
  id           String                @id
  name         String
  phone        String
  nationalId   String?
  amount       String                @default("")
  amountNum    Int                   @default(0)
  description  String?
  status       FacilityRequestStatus @default(pending)
  zohalStatus  String?
  zohalPayload Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([phone])
  @@index([status])
}

model InstallmentPlan {
  id               String                @id
  phone            String
  patientName      String?
  source           InstallmentSource
  title            String
  totalAmount      Int
  paidAmount       Int                   @default(0)
  installmentCount Int
  dueDates         String[]
  status           InstallmentPlanStatus @default(active)
  linkedRequestId  String?
  createdAt        DateTime              @default(now())

  @@index([phone])
  @@index([source])
  @@index([status])
  @@index([linkedRequestId])
}

// —— Phase 5: Club / loyalty ——

model ClubProfile {
  phone          String            @id
  userId         String?           @unique
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  points         Int               @default(0)
  visits         Int               @default(0)
  referrals      Int               @default(0)
  referredPhones String[]          @default([])
  redeemed       Json              @default("[]")
  brushHistory   String[]          @default([])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  history        ClubHistoryItem[]

  @@index([userId])
  @@index([points])
}

model ClubHistoryItem {
  id           String      @id
  profilePhone String
  profile      ClubProfile @relation(fields: [profilePhone], references: [phone], onDelete: Cascade)
  points       Int
  reason       String
  createdAt    DateTime    @default(now())

  @@index([profilePhone])
  @@index([createdAt])
}

model PaymentIntent {
  id            String    @id
  trackId       String?   @unique
  amountRial    Int
  amountToman   Int
  status        String    @default("pending")
  payload       Json
  resultPayload Json?
  successPath   String
  failPath      String
  basePath      String    @default("/dental")
  refNumber     String?
  failureReason String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([status])
  @@index([createdAt])
}

model DentalEducationClip {
  id            String   @id
  title         String
  level         String   @default("")
  description   String   @default("")
  videoUrl      String   @default("")
  durationLabel String   @default("")
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}
