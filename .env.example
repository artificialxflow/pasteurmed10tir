# Copy to .env.local (dev) or .env.production (Runflare) — no quotes

# --- .env.local (REMOTE — from your PC) ---
# DATABASE_URL=postgresql://USER:PASS@remote-pishgaman.runflare.com:32536/pasteurpods_db
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SESSION_SECRET=dev-secret-min-32-chars
