# Copy to .env.local (dev) or .env.production (Runflare) — no quotes

# --- .env.local (REMOTE — from your PC) ---
# DATABASE_URL=postgresql://USER:PASS@remote-pishgaman.runflare.com:32536/pasteurpods_db
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SESSION_SECRET=dev-secret-min-32-chars
# DEV_OTP_PHONE=09126723365
# DEV_OTP_CODE=00000
# NODE_ENV=development

# --- .env.production (INTERNAL — Runflare, BUILD PHASE) ---
# Same DEV_OTP as local until go-live — then remove DEV_OTP_* lines
# DATABASE_URL=postgresql://USER:PASS@pasteurplusdb-jkc-service:5432/pasteurpods_db
# NEXT_PUBLIC_SITE_URL=https://pasteur.plus
# SESSION_SECRET=production-secret-min-32-chars-different-from-dev
# DEV_OTP_PHONE=09126723365
# DEV_OTP_CODE=00000
# NODE_ENV=production
# Optional — Runflare persistent disk mount (default: {cwd}/public/uploads)
# UPLOAD_DIR=/app/public/uploads

# --- SMS (Host Iran / payamak-panel) ---
# SMS_USERNAME=
# SMS_API_KEY=
# SMS_BASE_URL=https://rest.payamak-panel.com
# SMS_OTP_BODY_ID=514428
# SMS_REMINDER_24H_BODY_ID=514430
# SMS_REMINDER_2H_BODY_ID=514431
# SMS_BOOKING_BODY_ID=514432
# SMS_CONSULTATION_BODY_ID=514436
# CRON_SECRET=long-random-string-for-reminder-cron

# --- Zohal ---
# ZOHAL_TOKEN=
# ZOHAL_BASE_URL=https://service.zohal.io/api/v0/services

# --- Zibal payment gateway ---
# ZIBAL_MERCHANT_ID=your-merchant-id-from-panel
# ZIBAL_SANDBOX=false
# For local sandbox testing only: ZIBAL_SANDBOX=true (uses merchant "zibal")











