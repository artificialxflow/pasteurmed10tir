# DEV_OTP_CODE=00000
# NODE_ENV=development

# --- .env.production (INTERNAL — Runflare, BUILD PHASE) ---
# Same DEV_OTP as local until go-live — then remove DEV_OTP_* lines
# DATABASE_URL=postgresql://USER:PASS@pasteurplusdb-jkc-service:5432/pasteurpods_db
# NEXT_PUBLIC_SITE_URL=https://pasteur.plus
# SESSION_SECRET=production-secret-min-32-chars-different-from-dev
# DEV_OTP_PHONE=09126723365
# DEV_OTP_CODE=00000
# NODE_ENV=production
# Optional — Runflare persistent disk mount (default: {cwd}/public/uploads)
# UPLOAD_DIR=/app/public/uploads
